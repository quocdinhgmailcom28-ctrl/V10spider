-- Engine xử lý góc nhìn Camera kết hợp di chuyển ảo
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        local moveVec = Vector3.new(0, 0, 0)
        
        -- Nhận tín hiệu từ nút bấm
        if moveStates.W then moveVec = moveVec + Vector3.new(0, 0, -1) end
        if moveStates.S then moveVec = moveVec + Vector3.new(0, 0, 1) end
        if moveStates.A then moveVec = moveVec + Vector3.new(-1, 0, 0) end
        if moveStates.D then moveVec = moveVec + Vector3.new(1, 0, 0) end
        
        if moveVec.Magnitude > 0 then
            -- Tính toán di chuyển dựa trên góc quay hiện tại của Camera 3D (Siêu mượt)
            local camCFrame = Workspace.CurrentCamera.CFrame
            local lookVector = camCFrame.LookVector
            local rightVector = camCFrame.RightVector
            
            -- Loại bỏ độ nghiêng trục Y để không bay lên trời
            local moveDir = (lookVector * -moveVec.Z) + (rightVector * moveVec.X)
            moveDir = Vector3.new(moveDir.X, 0, moveDir.Z).Unit
            
            char.Humanoid:Move(moveDir, false)
        end
        
        -- Xử lý nút Nhảy ảo
        if moveStates.Jump then
            char.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

